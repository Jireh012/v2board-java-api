# ===== Docker Compose 端口 =====
API_PORT=8080
WEB_PORT=80
# UI 源码路径（相对本仓库根目录，默认与本仓库同级的 v2board-ui）
# UI_CONTEXT=../v2board-ui

# ===== 外部 MySQL（第三方数据源，必填）=====
# 宿主机数据库可用 host.docker.internal；远程则填实际 IP/域名
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=v2board
DB_USERNAME=root
DB_PASSWORD=change_me
DB_SSL=false

# ===== 外部 Redis（第三方数据源，必填）=====
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=3000ms
REDIS_SSL=false
# 与 PHP REDIS_CACHE_DB 对齐
REDIS_CACHE_DB=1

# ===== 应用 =====
# 必须与 PHP V2Board 的 APP_KEY 一致
APP_KEY=base64:your-secret-key-here
APP_NAME=V2Board
APP_URL=
SUBSCRIBE_PATH=

# ===== 邮件（可选）=====
# MAIL_HOST=
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SSL=true

# ===== 第三方订阅源探测（可选）=====
# EXTERNAL_PROBE_URL=https://www.gstatic.com/generate_204
# EXTERNAL_PROBE_TIMEOUT_MS=8000
# EXTERNAL_PROBE_CONCURRENCY=4
# EXTERNAL_SUBSCRIBE_CRON=0 */30 * * * *
