# 开发环境配置示例
# 复制此文件为 application-dev.yml 并修改配置

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/v2board?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
    username: root
    password: your_password

  data:
    redis:
      host: localhost
      port: 6379
      database: 0
      # password:

# 必须配置：与 PHP V2Board 的 APP_KEY 一致（Laravel 格式 base64:xxxx，解码后 32 字节）
# 可用: openssl rand -base64 32
app:
  key: base64:please-replace-with-real-laravel-app-key-32b=

v2board:
  external-subscribe:
    # macOS Homebrew 常见路径；也可写 PATH 中的命令名 sing-box
    sing-box-path: /opt/homebrew/bin/sing-box
    # probe-url: https://www.gstatic.com/generate_204
    # concurrency: 4
    # cron: "0 */30 * * * *"

logging:
  level:
    com.v2board.api: DEBUG

